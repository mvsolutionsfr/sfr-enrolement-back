{# templates/migration/index.html.twig #}
<!DOCTYPE html>

<title>Telechargement des fichiers pour la reprise des données!</title>
{% block description %}Cette page permet d'uploader les fichiers pour reprendre l'historique de l'application d'enrolement V1 sous jBASE.{% endblock %}
{% block content %}
    <div class="container container-fluid">
        <div class="row">
            <div class="col-lg-8">
                {{ form_start(form, { attr: { 'accept-charset' : 'utf-8' }}) }}
                <div class="form-group">
                    {{ form_label(form.upload_file) }}
                    {{ form_widget(form.upload_file) }}
                    {{ form_errors(form.upload_file) }}
                </div>
                <div class="form-group">
                    {{ form_widget(form.send, {'label': "Fichier à télécharger", 'attr' : { 'class': 'btn btn-primary' }}) }}
                </div>
                {{ form_rest(form) }}
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}

